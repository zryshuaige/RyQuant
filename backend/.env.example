# 复制为 .env 后按需修改;所有项均有合理默认值,开发环境可不配置
SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# 后端监听端口(默认 8000;若被占用可在 runserver 时指定其他端口,并同步修改前端 BACKEND_ORIGIN)
# 启动示例:python manage.py runserver 127.0.0.1:8080

# 前端开发服务器来源(跨域白名单)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 行情模拟器:1 开启 / 0 关闭;tick 间隔秒数
MARKET_SIMULATION=1
SIMULATOR_TICK_SECONDS=3

# DeepSeek AI:留空时 AI 助手自动使用内置离线模拟回答
DEEPSEEK_API_KEY=
